# ==========================================
# .gitignore para Proyecto FundMix (Python)
# ==========================================

# Caché de Python (NO SUBIR)
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos Virtuales (NO SUBIR)
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db

# Configuración local de IDEs/Editores
.vscode/
.idea/
.cursorignore

# Archivos temporales de Streamlit (Opcional por seguridad futura)
.streamlit/secrets.toml


# Bases de datos locales (NO SUBIR)
*.db
*.sqlite
*.sqlite3

# PDFs de fichas de gestoras (curación local, NO SUBIR)
datos/
# Feature 002: backups con timestamp del Golden Record (datos/ ya está ignorado)
universo_fundmix.csv.bak_*

# Notas internas de trabajo
docs_proyecto/
project_summary.md